{
  "name": "nimoto",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nimoto \u2014 a daily skill competition Mini App for Nimiq Pay",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server/server.ts",
    "dev:web": "vite",
    "start": "tsx src/server/server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run -c vitest.node.config.ts && vitest run -c vitest.web.config.ts",
    "test:node": "vitest run -c vitest.node.config.ts",
    "test:web": "vitest run -c vitest.web.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/run.ts",
    "challenge:create": "tsx src/server/scripts/create-challenge.ts",
    "settle": "tsx src/server/scripts/settle.ts",
    "winners": "tsx src/server/scripts/winners.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.13.7",
    "@nimiq/core": "2.22.0",
    "@nimiq/hub-api": "1.15.0",
    "@nimiq/mini-app-sdk": "0.1.0",
    "drizzle-orm": "0.36.4",
    "hono": "4.6.13",
    "postgres": "3.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "drizzle-kit": "0.28.1",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
