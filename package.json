{
  "name": "nimoto",
  "private": true,
  "version": "1.0.0",
  "description": "Nimoto — a daily skill competition Mini App for Nimiq Pay",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @nimoto/api dev",
    "dev:web": "pnpm --filter @nimoto/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @nimoto/db generate",
    "db:migrate": "pnpm --filter @nimoto/db migrate",
    "db:seed": "pnpm --filter @nimoto/db seed",
    "challenge:create": "pnpm --filter @nimoto/api challenge:create",
    "settle": "pnpm --filter @nimoto/api settle",
    "payouts:run": "pnpm --filter @nimoto/api payouts:run"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  }
}
