# ---------------------------------------------------------------------------
# API (src/server)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nimoto
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Separate from wallet sessions: guards /api/admin and the settlement CLI.
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=replace-with-a-long-random-string

SESSION_COOKIE_NAME=nimoto_session
# Only set when the API and web app share a site.
# SESSION_COOKIE_DOMAIN=.nimoto.app

# Daily prize ladder, in NIM.
DAILY_PRIZE_1=30
DAILY_PRIZE_2=15
DAILY_PRIZE_3=10
DAILY_PRIZE_4_TO_10=5

# Payout safety rails, in NIM.
MAX_DAILY_PAYOUT_NIM=200
MAX_SINGLE_PAYOUT_NIM=100

# Treasury is optional. Without it the API runs in "no payout" mode and
# settlement only records what would be paid.
# NEVER commit a real key: inject it through your host's secret manager.
# TREASURY_PRIVATE_KEY=
# TREASURY_ADDRESS=
NIMIQ_NETWORK=test-albatross
# NIMIQ_RPC_URL=https://rpc.example/

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---------------------------------------------------------------------------
# Web (src/web)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8787
# Nimiq Hub endpoint used by the browser wallet flow.
# VITE_NIMIQ_HUB_URL=https://hub.nimiq-testnet.com

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/nimoto_test
